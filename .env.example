# Copy this file to .env and fill in your own keys. Never commit .env.

ANTHROPIC_API_KEY=

# LangSmith tracing (optional)
LANGSMITH_API_KEY=
# Set to true once LANGSMITH_API_KEY is filled in.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=backedcv-dev

# Optional overrides
# BACKEDCV_ENV=dev
# BACKEDCV_MODEL_FAST=claude-haiku-5-5
# BACKEDCV_MODEL_STRONG=claude-haiku-5-5
# Replay identical model calls from data/llm_cache.sqlite (entries expire after 24 hours).
# BACKEDCV_LLM_CACHE=true
# Model-using requests per client IP per hour, and per day for all clients.
# BACKEDCV_RATE_LIMIT_PER_HOUR=30
# BACKEDCV_DAILY_MODEL_RUNS=300
# LinkedIn job link reads per client IP per hour, and per day for all clients.
# BACKEDCV_JOB_LINK_PER_HOUR=20
# BACKEDCV_JOB_LINK_PER_DAY=500
# Behind a proxy that writes the caller's address in a header of its own (Cloudflare:
# CF-Connecting-IP), name that header so the per-client limits count real clients.
# BACKEDCV_CLIENT_IP_HEADER=

# Deeper analysis of a posting (it searches the web). Limits per client and per day.
# BACKEDCV_RESEARCH_ENABLED=true
# BACKEDCV_RESEARCH_PER_HOUR=5
# BACKEDCV_RESEARCH_PER_DAY=40
